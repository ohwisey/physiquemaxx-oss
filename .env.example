# Copy this file to .env.local and fill it in. Never commit real values.

# --- Supabase (your own project: supabase.com) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Claude / Anthropic (console.anthropic.com) ---
# The tested default. Paid, cents per analysis. Server-side only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Google Gemini (optional, free tier, NOT tested — see README) ---
# AI_PROVIDER=google
# GOOGLE_API_KEY=
# GOOGLE_MODEL=gemini-2.5-flash

# --- Optional: demo mode (sample data, no login) ---
# NEXT_PUBLIC_DEMO=1
